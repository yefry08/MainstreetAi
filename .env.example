# MainstreetAi — AI role keys
#
# Copy to `.env` (gitignored) and fill in. Both roles are inert without a key:
# the simulation falls back to its validated rules-based policy and the three
# built-in scenarios, so nothing breaks if you leave these blank.
#
# Two keys, not one, on purpose. The emulator invents traffic; the orchestrator
# influences signal timing. Separate keys mean you can budget, rate-limit,
# revoke and audit them independently, and a compromised scenario generator
# cannot reach the control path.

# Writes scenarios from a description ("a concert lets out in the rain").
MAINSTREET_EMULATOR_KEY=

# Sets signal policy from live network state.
MAINSTREET_ORCHESTRATOR_KEY=

# Either falls back to this if its own key is unset — convenient for local dev.
ANTHROPIC_API_KEY=

# --- optional overrides -----------------------------------------------------
# Both default to claude-opus-5.
# MAINSTREET_EMULATOR_KEY_MODEL=claude-opus-5
# MAINSTREET_ORCHESTRATOR_KEY_MODEL=claude-opus-5

# Keep the keys in place but run the deterministic baseline — useful when you
# want a reproducible A/B without deleting your configuration.
# MAINSTREET_ORCHESTRATOR_KEY_DISABLED=true
# MAINSTREET_EMULATOR_KEY_DISABLED=true
