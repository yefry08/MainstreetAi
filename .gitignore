# Generated simulation data. All of it is reproducible with:
#   python sim/fetch_osm.py && python sim/build_net.py &&
#   python sim/build_demand.py && python sim/export_geo.py
sim/net/*.osm.xml
sim/net/*.net.xml
sim/net/*.rou.xml
sim/net/*.trips.xml
sim/net/*.rou.alt.xml

# Exported map data (regenerate with sim/export_geo.py)
web/public/data/roads.geojson
web/public/data/signals.geojson

# Per-approach signal lamps (regenerate with sim/build_signal_approaches.py).
# Must be rebuilt whenever the network changes: the server emits one state
# byte per feature in this file's order, so a stale file silently mismatches
# the wire.
web/public/data/signal_approaches.geojson

# Real Open Data BCN layers (regenerate with sim/fetch_bcn_opendata.py)
web/public/data/bike_lanes.geojson
web/public/data/bicing.geojson

node_modules/
web/dist/
__pycache__/
*.pyc
.vite/

# Knowledge-graph output (regenerate with /graphify). Entirely derived from the
# source tree — graph.json, graph.html, GRAPH_REPORT.md and a 38-file AST cache,
# ~1.5 MB in total. Two of the sidecars (.graphify_python, .graphify_root) also
# record absolute paths to whichever machine produced them, which is worse than
# merely redundant in a shared repo.
graphify-out/

# Building footprints (regenerate with sim/fetch_buildings.py)
web/public/data/buildings.geojson

# Real transit geometry (regenerate with sim/transit/build_transit.py).
# The GTFS zip is 9 MB of someone else's data on a weekly release cycle, so it
# is fetched rather than vendored; transit.geojson is derived from it.
sim/transit/cache/
web/public/data/transit.geojson

# Isolated env for city2graph. The geo stack (geopandas/momepy/duckdb) has no
# wheels for this machine's default Python 3.14, so it is pinned to 3.11 and
# kept out of the main environment.
.venv-c2g/

# API keys — never commit. Copy .env.example to .env.
.env
.env.local
