# The static build: GitHub Pages and Vercel, where there is no Python server.
#
# With this set the hero plays the recorded Barcelona twins instead of opening a
# WebSocket. Without it the deployed page waits forever on a socket that cannot
# exist on a static host, and draws an empty city -- which is what shipped when a
# rebuild dropped the flag.
#
# Loaded automatically by `vite build --mode pages` (see package.json).
VITE_REPLAY_ONLY=1
