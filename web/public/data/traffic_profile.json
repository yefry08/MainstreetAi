 "derivation": {
  "congestion_is_not_volume": "The feed reports how congested a section is, not how many vehicles are on it. An empty road still reports 'very fluid', so the measured index floors around 0.45 of peak overnight while real volume is nearer 0.10. demand_by_day is therefore DERIVED: the shape is measured, the amplitude is rescaled.",
  "floor": 0.1,
  "gamma": 1.8,
  "formula": "demand = floor + (1-floor) * ((c - c_min)/(1 - c_min))**gamma",
  "c_min": 0.4275
 },
